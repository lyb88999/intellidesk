								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"User@123456\",\n  \"realName\": \"新用户\",\n  \"email\": \"newuser@intellidesk.com\",\n  \"phone\": \"13900139000\",\n  \"departmentId\": 1,\n  \"roleIds\": [2],\n  \"status\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/user",
							"host": [
								"{{baseUrl}}"
