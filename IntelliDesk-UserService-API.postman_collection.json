							"raw": "{{baseUrl}}/user/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"1"
							]
						},
						"description": "根据用户ID获取用户详细信息"
					},
					"response": []
				},
				{
					"name": "创建用户",
