						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"realName\": \"更新后的用户名\",\n  \"email\": \"updated@intellidesk.com\",\n  \"phone\": \"13911139111\",\n  \"departmentId\": 1,\n  \"roleIds\": [2, 3],\n  \"status\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/user/{{newUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"{{newUserId}}"
							]
						},
						"description": "更新用户信息"
					},
					"response": []
				},
				{
					"name": "分页查询用户列表",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has page data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('records');",
									"    pm.expect(jsonData.data).to.have.property('total');",
									"    pm.expect(jsonData.data.records).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/user/list?pageNum=1&pageSize=10&username=&realName=&status=",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"list"
							],
							"query": [
								{
									"key": "pageNum",
									"value": "1",
									"description": "页码"
								},
								{
									"key": "pageSize",
									"value": "10",
									"description": "每页大小"
								},
								{
									"key": "username",
									"value": "",
									"description": "用户名（可选）"
								},
								{
									"key": "realName",
									"value": "",
									"description": "真实姓名（可选）"
								},
								{
									"key": "status",
									"value": "",
									"description": "状态（可选）"
								}
							]
						},
						"description": "分页查询用户列表，支持多条件筛选"
					},
					"response": []
				},
				{
					"name": "删除用户",
