# IntelliDesk 环境变量配置文件
# 复制此文件为 .env 并修改相应配置

# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=intellidesk_root_2024
MYSQL_DATABASE=nacos
MYSQL_USER=intellidesk
MYSQL_PASSWORD=intellidesk_db_2024

# ==================== Redis 配置 ====================
REDIS_PASSWORD=
REDIS_MAXMEMORY=2gb

# ==================== RabbitMQ 配置 ====================
RABBITMQ_USER=intellidesk
RABBITMQ_PASSWORD=intellidesk_mq_2024
RABBITMQ_DEFAULT_VHOST=/

# ==================== Nacos 配置 ====================
NACOS_AUTH_ENABLE=true
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ==================== Elasticsearch 配置 ====================
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ==================== AI 配置 ====================
# OpenAI API Key (必填)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API Base URL (可选，国内用户可能需要代理)
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型选择
OPENAI_MODEL=gpt-4-turbo-preview

# 向量化模型
EMBEDDING_MODEL=text-embedding-3-small

# ==================== Grafana 配置 ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=intellidesk_grafana_2024

# ==================== Milvus 配置 ====================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ==================== 时区配置 ====================
TZ=Asia/Shanghai

# ==================== JVM 配置 ====================
# Gateway JVM 参数
GATEWAY_JVM_OPTS=-Xms512m -Xmx512m -XX:+UseG1GC

# User Service JVM 参数
USER_SERVICE_JVM_OPTS=-Xms512m -Xmx512m -XX:+UseG1GC

# Chat Service JVM 参数
CHAT_SERVICE_JVM_OPTS=-Xms512m -Xmx512m -XX:+UseG1GC

# Ticket Service JVM 参数
TICKET_SERVICE_JVM_OPTS=-Xms512m -Xmx512m -XX:+UseG1GC

# AI Service JVM 参数
AI_SERVICE_JVM_OPTS=-Xms1g -Xmx1g -XX:+UseG1GC

# ==================== 日志级别 ====================
LOG_LEVEL=INFO

# ==================== SkyWalking 配置 ====================
SW_AGENT_COLLECTOR_BACKEND_SERVICES=skywalking-oap:11800
SW_AGENT_NAME=intellidesk

# ==================== Sentinel 配置 ====================
SENTINEL_DASHBOARD_URL=sentinel-dashboard:8858

# ==================== 其他配置 ====================
# 环境标识 (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# 应用名称前缀
APP_NAME_PREFIX=intellidesk
